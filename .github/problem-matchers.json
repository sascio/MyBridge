{
  "problemMatcher": [
    {
      "owner": "streambridge-kotlin",
      "pattern": [
        {
          "regexp": "^e: (?:file://)?(.+?):(\\d+):(\\d+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "streambridge-r8",
      "pattern": [
        {
          "regexp": "^ERROR: (R8: .*|Missing class .*|.*defined multiple times.*)$",
          "message": 1
        }
      ]
    }
  ]
}
