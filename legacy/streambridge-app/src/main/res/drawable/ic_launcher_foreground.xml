<?xml version="1.0" encoding="utf-8"?>
<!-- Stream Bridge original mark: an arched bridge forming a play button. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bridge deck (arch) -->
    <path
        android:pathData="M 27,45 Q 54,19 81,45"
        android:strokeWidth="6.5"
        android:strokeColor="#8B7CFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Left pillar -->
    <path
        android:pathData="M 32,45 L 32,72"
        android:strokeWidth="6.5"
        android:strokeColor="#8B7CFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Right pillar -->
    <path
        android:pathData="M 76,45 L 76,72"
        android:strokeWidth="6.5"
        android:strokeColor="#5BD6E8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Play triangle centered under the arch -->
    <path
        android:pathData="M 48,51 L 66,61 L 48,71 Z"
        android:fillColor="#5BD6E8" />

    <!-- Water line -->
    <path
        android:pathData="M 26,82 L 82,82"
        android:strokeWidth="5"
        android:strokeColor="#8B7CFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeAlpha="0.55" />

</vector>
