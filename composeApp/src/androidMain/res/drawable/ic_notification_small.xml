<?xml version="1.0" encoding="utf-8"?>
<!-- StreamBridge notification small icon — monochrome white B mark on transparent.
     Android guidelines: pure white silhouette, no color, no background, scaled for 24dp.
     Derived from branding/streambridge-mark: arch + two legs + centered play triangle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Top arch of the B -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.55"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 6.2,9.8 Q 12,3.8 17.8,9.8" />
    <!-- Left leg -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.55"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 7.1,9.8 L 7.1,16.2" />
    <!-- Right leg -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.55"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 16.9,9.8 L 16.9,16.2" />
    <!-- Center play triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 10.6,11.2 L 14.8,13.55 L 10.6,15.90 Z" />
</vector>
